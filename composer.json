{
    "name": "siberfx/codelab-stats",
    "description": "Laravel client for CodeLabs Analytics (analytics.code-labs.nl): cached stats, a dashboard summary and optional JSON proxy routes.",
    "keywords": ["laravel", "analytics", "codelabs", "code-labs", "statistics", "privacy-analytics"],
    "homepage": "https://github.com/siberfx/codelabs-analytics",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Selim Görmüş",
            "email": "info@siberfx.com",
            "homepage": "https://siberfx.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3|^8.4|^8.5",
        "illuminate/cache": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Siberfx\\CodelabStats\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Siberfx\\CodelabStats\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Siberfx\\CodelabStats\\CodelabStatsServiceProvider"
            ],
            "aliases": {
                "CodelabStats": "Siberfx\\CodelabStats\\Facades\\CodelabStats"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
